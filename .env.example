# ============================================================
# Multi-Agent Orchestration Platform - Environment Template
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git!
# ============================================================

# ===== Database =====
# Local development (SQLite, zero-config):
DATABASE_URL=sqlite:///./agents.db
# Production (MySQL) — also used by docker-compose:
# DATABASE_URL=mysql+pymysql://root:yourpassword@127.0.0.1:3306/agent_platform?charset=utf8mb4

# MySQL container settings (used by docker-compose.yml only)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=agent_platform

# ===== DashScope (Qwen) - OpenAI-compatible interface =====
# Get your API key from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ===== Redis (used by Celery + Pub/Sub + rate-limit lock) =====
REDIS_URL=redis://localhost:6379/0

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== App Settings =====
DEBUG=true
SECRET_KEY=change-this-secret-key-in-production-please

# ===== LLM Retry =====
MAX_RETRIES=3

# ===== Reviewer Logic =====
# Maximum revision attempts before forcing completion
MAX_REVISIONS=3